# Grotto environment contract.
#
# This file is the single declaration of every value Grotto reads from its
# environment: canonical name, sensitivity, type, and the exact 1Password
# reference each lifecycle resolves. Values live in 1Password; this file never
# contains one. There is no `.env` step anywhere — local development, Cursor
# cloud agents, GitHub Actions, and the Mac mini all resolve through this
# schema.
#
# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent installs, the mini's deploy job).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=fallback($CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, $CI_DEVELOPMENT_OP_TOKEN), allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and every
# test lane run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a masked value rather than a
# plaintext string inlined into the App bundle. Public values opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. Both are @internal, so `varlock run` never exports them into the
# Server process or into a rendered config file.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name. The self-hosted GitHub Actions runner on the
# Mac mini injects the GitHub deploy agent's read-only token (repository secret
# GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN).
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared Cursor cloud-agent development identity, read-only on the Development
# vault, injected by Cursor as an account-scoped Runtime Secret. Supervised
# local development leaves this empty and uses desktop-app authorization.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# CI development role slot. Quality supplies the fleet deploy identity here;
# that identity can read Development for licensed dependency installation.
# Cursor credentials never cross into GitHub Actions.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CI_DEVELOPMENT_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches, so the Vite build,
# the dev stack, the Server, and every test lane never contact 1Password. Only
# switches with a real consumer are declared: Grotto has no Cloudflare API
# token (the named Tunnel authenticates with a host credential file), so there
# is no deploy switch.

# Set to true by the install paths (`.cursor/install.sh`, the Quality
# workflow) when fetching install tokens with `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
GROTTO_RESOLVE_INSTALL_TOKENS=false

# Set to true by the operator release commands (`release:publish`,
# `computer:release`, `publish:desktop`) so Apple, S3, and Computer signing
# credentials resolve. Off by default, which is what lets `env:load` and
# `check` succeed on a Cursor cloud agent that can reach none of them.
# @public @internal @auditIgnore @type=boolean
GROTTO_RESOLVE_RELEASE_TOKENS=false


# --- Install-time machinery ----------------------------------------------
# Both are licensed registry credentials shared across the whole suite, so the
# name identifies the issuing owner rather than this repo and each resolves
# from the existing shared item — no per-repo copy is created.

# Licensed @hugeicons-pro dist downloads for the App icon set. Referenced
# literally by bunfig.toml's `[install.scopes]` token.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_HUGEICONS_LICENSE_KEY=if(eq($GROTTO_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HugeIcons Pro - Merchbase/credential"), "")

# Licensed HeroUI Pro dist downloads. `scripts/setup-worktree.mjs` bridges this
# canonical name onto the vendor installer's literal HEROUI_AUTH_TOKEN.
# @sensitive @internal @auditIgnore @optional
HEROUI_PRO_CICD_TOKEN=if(eq($GROTTO_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HeroUI Pro CICD - Merchbase/credential"), "")


# --- Clerk (Grotto's own tenancy) ----------------------------------------
# Grotto has its own Clerk application, separate from the Merchbase suite
# instance: development is worthy-peacock-11.clerk.accounts.dev and production
# is clerk.grotto.sh. Both credentials are therefore project-owned.

# The Clerk instance origin whose JWKS signs human session tokens. Naming the
# development instance explicitly is deliberate: pointing a development arm at
# the production issuer makes every locally minted token fail the issuer check.
# @public @type=url
GROTTO_CLERK_ISSUER_URL=ifs(eq($VARLOCK_ENV, production), https://clerk.grotto.sh, eq($VARLOCK_ENV, test), https://clerk-test.grotto.invalid, https://worthy-peacock-11.clerk.accounts.dev)

# Clerk Backend API origin. Only ever set for a non-production Clerk instance;
# nothing provisions it today and the Server falls back to Clerk's default.
# @public @optional
GROTTO_CLERK_API_URL=

# Backend key. The hosted Server needs it to confirm which of a human's email
# addresses Clerk has verified, and the dev auto sign-in flow mints tokens with
# it. Without it the Server still boots but Server invitations cannot be
# accepted.
# @sensitive @required=forEnv(production)
GROTTO_CLERK_SECRET_KEY=ifs(eq($VARLOCK_ENV, test), sk_test_grotto_fixture_key, eq($VARLOCK_ENV, production), op(production, "op://Production/Clerk - Grotto/credential"), op(development, "op://Development/Clerk - Grotto/credential"))

# Clerk user the localhost-only automatic dev sign-in flow signs in as.
# Development only: production never auto-signs anyone in.
# @sensitive @optional
GROTTO_DEV_CLERK_SIGN_IN_USER_ID=ifs(eq($VARLOCK_ENV, test), user_grotto_test_fixture, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Dev Sign-In User - Grotto/username"))


# --- Hosted Grotto Server runtime ----------------------------------------
# Production values are literals for host paths and ports the operator fixed at
# cutover, and 1Password references for anything secret. Development and test
# resolve to `undefined` wherever the dev stack derives the value per worktree
# — `undefined`, never "", because the Server's zod schema treats an empty
# string as present and would reject it instead of applying its default.

# Grotto App origin the Server advertises. Development derives it from the
# per-worktree website port.
# @public @optional @type=url
GROTTO_APP_ORIGIN=if(eq($VARLOCK_ENV, production), https://grotto.sh, undefined)

# Loopback port the Server binds. The Cloudflare Tunnel sends grotto.sh here.
# Development derives a per-worktree port.
# @public @optional @type=port
GROTTO_SERVER_PORT=if(eq($VARLOCK_ENV, production), 18791, undefined)

# Attachment tree root. Owned by _grotto_server on the mini; the dev stack puts
# it under the per-worktree state directory.
# @public @optional
GROTTO_ATTACHMENT_ROOT=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/grotto/data/attachments, undefined)

# Built Grotto App the Server serves from its own origin. Production only: in
# development Vite serves the App.
# @public @optional
GROTTO_STATIC_APP_ROOT=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/grotto/current/share/grotto-server/app, undefined)

# Release identity manifest of the activated release. Its presence is what
# makes the Server treat itself as a production release, so it is production
# only.
# @public @optional
GROTTO_RELEASE_MANIFEST=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/grotto/current/release.json, undefined)

# Signed Grotto Computer update descriptor the Server hands to attached
# Computers.
# @public @optional @type=url
GROTTO_COMPUTER_RELEASE_MANIFEST_URL=if(eq($VARLOCK_ENV, production), https://releases.grotto.sh/computer/latest.json, undefined)

# Optional Server-owned OpenAI credential for the transient avatar generator.
# Keep this unset until the operator provisions the matching credential in the
# lifecycle vault; the Server reports avatar generation as unavailable without
# it and all deterministic test fixtures stay offline.
# @sensitive @optional
GROTTO_OPENAI_API_KEY=undefined

# Local-only deterministic image provider for the opt-in Agent E2E recipe scenario.
# It is honored only by a development stack and records request counts at the
# operator-selected path; never set it in a released Server environment.
# @public @optional
GROTTO_AGENT_E2E_AVATAR_FIXTURE=undefined

# Absolute path to the checked-in PNG used by the local fixture.
# @public @optional
GROTTO_AGENT_E2E_AVATAR_FIXTURE_PATH=undefined

# Optional absolute JSONL report path paired with the local avatar fixture.
# @public @optional
GROTTO_AGENT_E2E_AVATAR_REQUEST_LOG=undefined


# --- PostgreSQL ----------------------------------------------------------
# One cluster on the mini, three least-privilege roles, one 1Password item.
# Development runs a throwaway per-worktree cluster with no password at all, so
# every arm below is production-only.

# Runtime login: CONNECT, schema USAGE, and table DML only. Read by the Server.
# Required in production: the Server's typed env carries a local-development
# default, so a missing value would boot it against the wrong database instead
# of failing.
# @sensitive @required=forEnv(production)
GROTTO_DATABASE_URL=ifs(eq($VARLOCK_ENV, test), postgres://grotto_runtime:grotto@127.0.0.1:5438/grotto_test, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Grotto/runtime url"), undefined)

# Migration login (grotto_bootstrap): owns the database and its public schema.
# Read ONLY by the deploy job's migration step, never by the running Server.
# @sensitive @required=forEnv(production)
GROTTO_DATABASE_MIGRATION_URL=ifs(eq($VARLOCK_ENV, test), postgres://grotto_bootstrap:grotto@127.0.0.1:5438/grotto_test, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Grotto/migration url"), undefined)

# Container superuser password for the pinned PostgreSQL image. Interpolated by
# apps/server/compose.yml when the deploy job brings the database up under
# `varlock run`.
# @sensitive @required=forEnv(production)
GROTTO_POSTGRES_ADMIN_PASSWORD=ifs(eq($VARLOCK_ENV, test), grotto-test-admin-password, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Grotto/admin password"), undefined)

# Least-privilege role names the bootstrap and migration programs grant to.
# Public: they are role names, not credentials.
# @public
GROTTO_DATABASE_RUNTIME_ROLE=grotto_runtime

# The read-only role every migration re-grants. The scheduled off-machine
# backup that used it has been retired; the role and its grants stay so the
# migration program's privilege model is unchanged.
# @public
GROTTO_DATABASE_BACKUP_ROLE=grotto_backup

# One-time fresh-cluster bootstrap login. Nothing provisions it: the operator
# supplies it by hand for the single bootstrap run on a brand-new database.
# @sensitive @optional
GROTTO_DATABASE_BOOTSTRAP_URL=


# --- Google Calendar MCP connection --------------------------------------
# OAuth client the Server presents when an operator connects Google Calendar as
# a remote MCP server. Only a development client exists today; the hosted
# Server resolves `undefined` and reports the connection as unavailable until a
# production client is registered.

# @sensitive @optional
GROTTO_GOOGLE_OAUTH_CLIENT_ID=ifs(eq($VARLOCK_ENV, test), grotto-test.apps.googleusercontent.com, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Google MCP OAuth - Grotto/username"))

# @sensitive @optional
GROTTO_GOOGLE_OAUTH_CLIENT_SECRET=ifs(eq($VARLOCK_ENV, test), grotto-test-google-oauth-secret, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Google MCP OAuth - Grotto/credential"))


# --- Grotto App build inputs ---------------------------------------------
# External literal-prefix exemption: Vite only exposes variables whose name
# begins with VITE_, so the prefix is a platform requirement rather than a
# naming choice. Everything here is inlined into a public browser bundle at
# build time and must therefore be @public — a @sensitive value in this block
# would ship to every visitor.

# Clerk publishable keys are public by design, but they stay in the contract so
# the App and the Server cannot drift onto different Clerk instances. The
# production key is the same literal the iOS client compiles in.
#
# The release switch is checked FIRST, ahead of the lifecycle, and that ordering
# is the whole point. A release is published from an operator's machine, which
# necessarily resolves the development lifecycle: the production 1Password
# instance sets `allowAppAuth=false` and the development one allows desktop
# authorization only `forEnv(development)`, so no release can run under
# VARLOCK_ENV=production. Selecting this key by lifecycle alone therefore inlined
# the development instance's key into the Server artifact users actually run.
# `GROTTO_RESOLVE_RELEASE_TOKENS=true` means exactly "this run produces a
# shippable artifact", which is the real question this value depends on.
# @public
VITE_CLERK_PUBLISHABLE_KEY=ifs(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), pk_live_Y2xlcmsuZ3JvdHRvLnNoJA, eq($VARLOCK_ENV, production), pk_live_Y2xlcmsuZ3JvdHRvLnNoJA, eq($VARLOCK_ENV, test), pk_test_Z3JvdHRvLXRlc3QuZ3JvdHRvLmludmFsaWQk, pk_test_d29ydGh5LXBlYWNvY2stMTEuY2xlcmsuYWNjb3VudHMuZGV2JA)

# Localhost-only automatic sign-in in the App. Development only.
# @public @optional @type=boolean
VITE_DEV_CLERK_AUTO_SIGN_IN=if(eq($VARLOCK_ENV, development), true, undefined)

# Browser-reachable App origin embedded in manually delivered invitation links.
# Required for packaged desktop builds, whose file: origin cannot be shared.
# Operator-supplied at build time; nothing provisions it per lifecycle.
# @public @optional @type=url
VITE_GROTTO_APP_ORIGIN=


# --- Release credentials -------------------------------------------------
# Release material lives in the Tooling vault, which NO service identity reads.
# Every reference below therefore resolves through the development instance, so
# an operator running a release under `varlock run` satisfies it with desktop
# authorization (Touch ID). All of it is gated on the release switch: cloud
# agents, CI, and the dev stack must never evaluate these refs.
#
# Two credentials are shared, not project-owned. Grotto's notarization identity
# and its release-bucket IAM key were byte-for-byte the same values the
# Merchbase desktop app already stores, so this repo adopts those items rather
# than minting duplicates. The env names stay literal: electron-builder,
# notarytool, and the aws CLI each read them under their own name.

# Apple ID and app-specific password for notarizing the Grotto desktop app and
# the Grotto Computer executable. Shared suite identity.
# @sensitive @internal @auditIgnore @optional
APPLE_ID=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/Apple Notarization - Merchbase/username"), "")

# @sensitive @internal @auditIgnore @optional
APPLE_APP_SPECIFIC_PASSWORD=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/Apple Notarization - Merchbase/credential"), "")

# App Store Connect API key, read by the iOS TestFlight upload
# (xcodebuild `-authenticationKey*`). Unprovisioned: no key has been issued for
# Grotto, so a TestFlight upload is an operator-supplied step until one is.
# The .p8 private key stays a file on the operator's disk; only its location
# travels, and a path is not a credential.
# @sensitive @internal @auditIgnore @optional
APPLE_API_KEY_ID=

# @sensitive @internal @auditIgnore @optional
APPLE_API_ISSUER=

# @public @optional
APPLE_API_KEY_PATH=

# Apple Developer team id. Public: it appears in every signed binary and in the
# generated Computer installer script.
# @public
APPLE_TEAM_ID=XJ8RZZT99R

# Developer ID Application identity. The certificate and its private key stay
# in the operator's login Keychain — only the identity's name travels, and it
# is public.
# @public
APPLE_SIGNING_IDENTITY=Developer ID Application: Zachary Adam Knickerbocker (XJ8RZZT99R)

# Destination bucket for published desktop and Computer artifacts. The URI is
# public; the IAM credentials that write it are the shared Merchbase desktop
# release key, adopted rather than duplicated.
# @public
GROTTO_RELEASE_S3_URI=s3://punchpress-electron-app-209596837609-us-east-1-an/tavern/mac

# @sensitive @internal @auditIgnore @optional
AWS_ACCESS_KEY_ID=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/S3 Release - Merchbase Desktop/username"), "")

# @sensitive @internal @auditIgnore @optional
AWS_SECRET_ACCESS_KEY=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/S3 Release - Merchbase Desktop/credential"), "")

# Public base URL the electron-updater feed reads.
# @public @type=url
GROTTO_RELEASE_BASE_URL=https://punchpress-electron-app-209596837609-us-east-1-an.s3.us-east-1.amazonaws.com/tavern/mac

# Public base URL every installed Grotto Computer polls for updates.
# @public @type=url
GROTTO_COMPUTER_RELEASE_BASE_URL=https://releases.grotto.sh/computer

# Ed25519 keypair that signs the Grotto Computer release descriptor. The
# private half is the strongest credential in this schema: anything holding it
# can publish an update every installed Computer will accept.
# @sensitive @internal @auditIgnore @optional
GROTTO_COMPUTER_RELEASE_PRIVATE_KEY=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/Computer Release Signing - Grotto/private key"), "")

# Public half. Compiled into every Computer build as its update trust anchor.
# @public @optional
GROTTO_COMPUTER_RELEASE_PUBLIC_KEY=if(eq($GROTTO_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/Computer Release Signing - Grotto/public key"), "")
