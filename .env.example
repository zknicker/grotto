APP_ORIGIN=http://localhost:3100
# Dev stack defaults are generated per worktree under ~/.tavern/dev/<worktree-id>/.
# TAVERN_DEV_STACK_ID=tavern-local
# TAVERN_DEV_PORT_BASE=43000
# Hosted Grotto Server (bun apps/server/src/grotto-server.ts). Its PostgreSQL
# owns collaboration state. Bootstrap a fresh schema explicitly before starting it.
# GROTTO_SERVER_PORT=8090
# GROTTO_ATTACHMENT_ROOT=~/.grotto/server/attachments
# GROTTO_DATABASE_URL=postgres://grotto_runtime:LOCAL_PASSWORD@127.0.0.1:5432/grotto
# GROTTO_DATABASE_BOOTSTRAP_URL=postgres://grotto_bootstrap:LOCAL_PASSWORD@127.0.0.1:5432/grotto
# GROTTO_DATABASE_RUNTIME_ROLE=grotto_runtime
# Signed Grotto Computer production updates.
# GROTTO_COMPUTER_RELEASE_MANIFEST_URL=https://releases.grotto.sh/computer/latest.json
# GROTTO_COMPUTER_RELEASE_BASE_URL=https://releases.grotto.sh/computer
# Optional on macOS when the documented Computer release Keychain items exist:
# GROTTO_COMPUTER_RELEASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GROTTO_COMPUTER_RELEASE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
HUGEICONS_LICENSE_KEY=
# MerchBase Plugin
# TAVERN_MERCHBASE_ENABLED=true
# TAVERN_MERCHBASE_API_KEY=
# TAVERN_MERCHBASE_BASE_URL=https://app.merchbase.co
# TAVERN_MERCHBASE_DEFAULT_ACCOUNT=
# TAVERN_MERCHBASE_DEFAULT_MARKETPLACE=
# Google Plugin
# TAVERN_GOOGLE_OAUTH_CLIENT_ID=
# TAVERN_GOOGLE_OAUTH_CLIENT_SECRET=
# Browser Plugin: root for managed Chrome profiles (default ~/.grotto/browser)
# TAVERN_BROWSER_HOME=
# Desktop release publishing
# TAVERN_RELEASE_BASE_URL=https://example.com/mac
# TAVERN_RELEASE_S3_URI=s3://example-bucket/mac
# APPLE_SIGNING_IDENTITY=
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH=

# Clerk authentication (Grotto App sign-in). Pull real values with `clerk env pull`
# into apps/website/.env.local. Never commit real keys.
# VITE_CLERK_PUBLISHABLE_KEY=
# Hosted Grotto Server Clerk verification: the Clerk instance origin whose JWKS
# signs human session tokens. Defaults to the production instance.
# CLERK_ISSUER_URL=https://clerk.grotto.sh
# App origin of the hosted Grotto Server, for the /s routes.
# VITE_GROTTO_SERVER_ORIGIN=http://localhost:8090
# Browser-reachable App origin used in manually delivered invitation links.
# Required for packaged desktop builds, whose file: origin cannot be shared.
# Keep this equal to APP_ORIGIN.
# VITE_GROTTO_APP_ORIGIN=http://localhost:3100
# Clerk Backend API origin. Only set it for a non-production Clerk instance.
# CLERK_API_URL=https://api.clerk.com
# Clerk secret key. Dev auto sign-in uses it, and the hosted Grotto Server needs
# it to confirm which of a human's email addresses Clerk has verified — without
# it the Server still runs but Server invitations cannot be accepted. Grotto
# stores the address an invitation is bound to and nothing else: Clerk remains
# the only source of which addresses are verified, and Grotto keeps no profile
# email for a User. Keep real values in the machine-local root .env.
# CLERK_SECRET_KEY=
# Clerk user used by the localhost-only automatic dev sign-in flow.
# DEV_CLERK_SIGN_IN_USER_ID=
