{
  "name": "the-tavern",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-dev-stack.mjs web",
    "dev-app": "node scripts/run-dev-stack.mjs desktop",
    "dev:shared": "node scripts/run-shared-dev-stack.mjs",
    "build": "bun run --filter @tavern/api build && bun run --filter @tavern/sdk build && bun run --filter @tavern/claude-usage build && bun run --filter @tavern/codex-usage build && bun run --filter @tavern/server build && bun run --filter @tavern/runtime build && bun run --filter @tavern/website build",
    "build:desktop": "bun run desktop:build",
    "build:desktop:unsigned": "bun run --filter @tavern/website desktop:build:unsigned",
    "desktop:build": "bun run --filter @tavern/website desktop:build",
    "desktop:release": "bun run --filter @tavern/website desktop:release",
    "publish:desktop": "bun run --filter @tavern/website desktop:publish",
    "release:bump": "node scripts/release/bump-version.mjs",
    "release:notes": "node scripts/release/extract-release-notes-from-changelog.mjs",
    "release:collect-changelog-context": "node scripts/release/collect-changelog-context.mjs",
    "release:check": "node scripts/release/validate-release-metadata.mjs",
    "release:check-desktop-artifacts": "node scripts/release/check-desktop-artifacts.mjs",
    "release:build-runtime-artifact": "node scripts/release/build-runtime-artifact.mjs",
    "build:grotto-server-artifact": "node scripts/build-grotto-server-artifact.mjs",
    "deploy:grotto-server": "bun scripts/deploy-grotto-server.ts",
    "release:publish-homebrew-formula": "node scripts/release/publish-homebrew-formula.mjs",
    "release:publish": "node scripts/release/publish-release.mjs",
    "computer:release": "node scripts/release/publish-computer.mjs",
    "test:e2e": "bun run --filter @tavern/website test:e2e",
    "test:e2e:debug": "bun run --filter @tavern/website test:e2e:debug",
    "test:e2e:headed": "bun run --filter @tavern/website test:e2e:headed",
    "test:e2e:screenshot": "bun run --filter @tavern/website test:e2e:screenshot",
    "test:e2e:screenshot-failures": "bun run --filter @tavern/website test:e2e:screenshot-failures",
    "test:e2e:ui": "bun run --filter @tavern/website test:e2e:ui",
    "eval:design": "bun scripts/design-eval.mjs",
    "eval:prompt": "node scripts/prompt-eval.mjs",
    "eval:sessions": "node scripts/session-eval.mjs",
    "typecheck": "bun run --filter @tavern/api typecheck && bun run --filter @tavern/sdk typecheck && bun run --filter @tavern/claude-usage typecheck && bun run --filter @tavern/codex-usage typecheck && bun run --filter @tavern/server typecheck && bun run --filter @tavern/runtime typecheck && bun run --filter @tavern/website typecheck",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "sync:browser-skill": "node scripts/sync-browser-skill.mjs",
    "docs:list": "docs-list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "ultracite": "7.3.0",
    "zod": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "brace-expansion": "5.0.6",
    "esbuild": "0.27.4",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "ip-address": "10.2.0",
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "protobufjs": "7.5.9",
    "qs": "6.15.2",
    "vite": "7.3.3",
    "ws": "8.21.0"
  },
  "patchedDependencies": {
    "@shadcn/react@0.1.0": "patches/@shadcn%2Freact@0.1.0.patch",
    "@ai-sdk/harness-pi@1.0.8": "patches/@ai-sdk%2Fharness-pi@1.0.8.patch",
    "@ai-sdk/harness-claude-code@1.0.8": "patches/@ai-sdk%2Fharness-claude-code@1.0.8.patch",
    "@ai-sdk/harness@1.0.8": "patches/@ai-sdk%2Fharness@1.0.8.patch"
  }
}
