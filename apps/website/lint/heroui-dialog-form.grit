// A dialog's Header, Body, and Footer are its own layout children. Wrapping
// them in a Form collapses that layout and unpins the footer; the Form goes
// inside the Body slot, with footer buttons submitting it by id.
language js

`<Form $attrs>$body</Form>` where {
  $body <: contains or {
    `<Drawer.Footer $p>$c</Drawer.Footer>`,
    `<Modal.Footer $p>$c</Modal.Footer>`,
    `<AlertDialog.Footer $p>$c</AlertDialog.Footer>`
  },
  register_diagnostic(
    span = $body,
    message = "Form wraps dialog compound parts. Put the Form inside the Body slot so the header and footer keep the dialog layout. See docs/internals/react.md."
  )
}
