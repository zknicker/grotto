// A HeroUI compound header or footer lays its own children out. Dropping a
// layout element straight into one replaces that layout instead of composing
// with it: Modal.Header stacks Icon over Heading over one muted line, so a
// flex row inside it strands the icon on its own row.
//
// Direct children only — a Body slot is exactly where custom layout belongs.
language js

or {
  `<Modal.Header $attrs>$children</Modal.Header>`,
  `<Modal.Footer $attrs>$children</Modal.Footer>`,
  `<AlertDialog.Header $attrs>$children</AlertDialog.Header>`,
  `<AlertDialog.Footer $attrs>$children</AlertDialog.Footer>`
} where {
  $children <: some `<$el $p>$c</$el>` where { $el <: or { `div`, `span`, `section` } },
  register_diagnostic(
    span = $children,
    message = "Layout element as a direct child of a HeroUI compound header/footer. Compose the compound parts instead; custom layout belongs in the Body slot. See docs/internals/react.md."
  )
}
