{
  "name": "@grotto/server",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bun --watch src/grotto-server.ts",
    "bootstrap:grotto": "bun src/grotto-server-bootstrap.ts",
    "build": "bun build src/grotto-server.ts --target bun --format esm --outdir dist",
    "start": "bun dist/grotto-server.js",
    "lint": "ultracite check src test",
    "lint:fix": "ultracite fix src test",
    "test": "drizzle-kit check --config=drizzle.postgres.config.ts && node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.postgres.config.ts",
    "db:check:postgres": "drizzle-kit check --config=drizzle.postgres.config.ts",
    "db:migrate": "GROTTO_MIGRATIONS_FOLDER=drizzle/postgres bun src/grotto-server-migrate.ts",
    "db:migrate:postgres": "GROTTO_MIGRATIONS_FOLDER=drizzle/postgres bun src/grotto-server-migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.31",
    "@fastify/cors": "11.2.0",
    "@fastify/static": "9.1.3",
    "@grotto/api": "workspace:*",
    "@grotto/agent-manual": "workspace:*",
    "@grotto/claude-usage": "workspace:*",
    "@grotto/codex-usage": "workspace:*",
    "@grotto/sdk": "workspace:*",
    "@trpc/server": "11.12.0",
    "bottleneck": "2.19.5",
    "bunqueue": "2.6.38",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "jose": "6.2.3",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@trpc/client": "11.12.0",
    "@types/ws": "8.18.1",
    "@types/node": "24.12.0",
    "bun-types": "1.3.13",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
