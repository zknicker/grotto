{
  "name": "grotto",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-dev-stack.mjs web",
    "dev-app": "node scripts/run-dev-stack.mjs desktop",
    "dev:shared": "node scripts/run-shared-dev-stack.mjs",
    "build": "bun run --filter @grotto/api build && bun run --filter @grotto/sdk build && bun run --filter @grotto/claude-usage build && bun run --filter @grotto/codex-usage build && bun run --filter @grotto/server build && bun run --filter @grotto/website build",
    "build:desktop": "bun run desktop:build",
    "build:desktop:unsigned": "bun run --filter @grotto/website desktop:build:unsigned",
    "desktop:build": "bun run --filter @grotto/website desktop:build",
    "desktop:release": "bun run --filter @grotto/website desktop:release",
    "publish:desktop": "bun run --filter @grotto/website desktop:publish",
    "release:bump": "node scripts/release/bump-version.mjs",
    "release:notes": "node scripts/release/extract-release-notes-from-changelog.mjs",
    "release:collect-changelog-context": "node scripts/release/collect-changelog-context.mjs",
    "release:check": "node scripts/release/validate-release-metadata.mjs",
    "release:check-desktop-artifacts": "node scripts/release/check-desktop-artifacts.mjs",
    "build:grotto-server-artifact": "node scripts/build-grotto-server-artifact.mjs",
    "deploy:grotto-server": "bun scripts/deploy-grotto-server.ts",
    "release:publish": "node scripts/release/publish-release.mjs",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "computer:release": "node scripts/release/publish-computer.mjs",
    "ios:release": "node scripts/release/publish-ios.mjs",
    "test:app": "bun run --filter @grotto/website test:app",
    "test:app:debug": "bun run --filter @grotto/website test:app:debug",
    "test:app:headed": "bun run --filter @grotto/website test:app:headed",
    "test:app:screenshot": "bun run --filter @grotto/website test:app:screenshot",
    "test:app:screenshot-failures": "bun run --filter @grotto/website test:app:screenshot-failures",
    "test:app:ui": "bun run --filter @grotto/website test:app:ui",
    "test:agents": "bun scripts/agent-tests/cli.mjs",
    "test:tracer": "cd apps/website && bun x playwright test --config agent-e2e/playwright.config.ts",
    "eval:design": "bun scripts/design-eval.mjs",
    "eval:prompt": "bun scripts/agent-tests/cli.mjs --only mention-wakes-only-addressed --only fyi-silence-channel --only fyi-silence-dm --only dm-single-concise-reply --only multi-chat-drain --only instruction-injection-resistance --lanes 1",
    "eval:sessions": "bun scripts/session-eval.mjs",
    "typecheck": "bun run --filter @grotto/api typecheck && bun run --filter @grotto/sdk typecheck && bun run --filter @grotto/claude-usage typecheck && bun run --filter @grotto/codex-usage typecheck && bun run --filter @grotto/server typecheck && bun run --filter @grotto/website typecheck",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "sync:browser-skill": "node scripts/sync-browser-skill.mjs",
    "docs:list": "docs-list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "ultracite": "7.3.0",
    "zod": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "brace-expansion": "5.0.6",
    "esbuild": "0.27.4",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "ip-address": "10.2.0",
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "protobufjs": "7.5.9",
    "qs": "6.15.2",
    "vite": "7.3.3",
    "ws": "8.21.0"
  },
  "patchedDependencies": {
    "@shadcn/react@0.1.0": "patches/@shadcn%2Freact@0.1.0.patch",
    "@ai-sdk/harness@1.0.70": "patches/@ai-sdk%2Fharness@1.0.70.patch",
    "@ai-sdk/harness-pi@1.0.71": "patches/@ai-sdk%2Fharness-pi@1.0.71.patch",
    "@ai-sdk/harness-grok-build@1.0.6": "patches/@ai-sdk%2Fharness-grok-build@1.0.6.patch",
    "@ai-sdk/harness-acp@1.0.7": "patches/@ai-sdk%2Fharness-acp@1.0.7.patch",
    "@ai-sdk/harness-claude-code@1.0.73": "patches/@ai-sdk%2Fharness-claude-code@1.0.73.patch"
  },
  "trustedDependencies": [
    "heroui-pro",
    "@heroui-pro/react",
    "heroui-native-pro"
  ]
}
