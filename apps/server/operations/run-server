#!/bin/sh
set -eu
umask 077
# The deploy job renders config/server.env from the committed .env.schema under
# `varlock run`; it is the delivered runtime copy and the only owner of every
# value below. Nothing here re-enters varlock: a launchd job that did would
# re-resolve the schema at boot under the development lifecycle.
set -a
. "/Users/zknicker/srv/grotto/config/server.env"
set +a
export NODE_ENV=production
exec /Users/zknicker/srv/grotto/current/bin/grotto-server
