{
  "extends": ["ultracite/core", "ultracite/react"],
  // HeroUI compound-composition rules. Structural only — a className that
  // cancels a component's own spacing is not expressible in GritQL, so that
  // half lives in apps/website/src/lib/heroui-composition-contract.test.ts.
  "plugins": [
    "./apps/website/lint/heroui-compound-children.grit",
    "./apps/website/lint/heroui-dialog-form.grit"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!.claude/settings.local.json",
      "!.context",
      "!apps/ios-swift/**/*.xcassets",
      // Generated hugeicons geometry — one line of path data per family.
      "!apps/ios-swift/Sources/GrottoUI/Resources/*-icons.json",
      "!apps/server/dist",
      "!apps/server/drizzle/meta",
      "!apps/website/dist",
      "!apps/website/src-tauri/gen/schemas",
      "!apps/website/src/components/charts",
      "!assets/mac-icon.icon",
      "!**/*.css",
      "!**/*.grit"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100,
    "lineEnding": "lf",
    "formatWithErrors": true,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off"
      },
      "correctness": {
        "noUnresolvedImports": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noExportedImports": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "useConsistentMemberAccessibility": "off",
        "useDefaultSwitchClause": "off",
        "noParameterProperties": "off"
      },
      "suspicious": {
        "noBitwiseOperators": "off",
        "noControlCharactersInRegex": "off",
        "noEmptyBlockStatements": "off",
        "noMisplacedAssertion": "off",
        "useAwait": "off"
      }
    }
  }
}
